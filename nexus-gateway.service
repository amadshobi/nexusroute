# ─────────────────────────────────────────────────────────────
# NexusRoute Gateway — Interceptor, Caching & Telemetry Daemon
# Systemd User Service (canonical)
# ─────────────────────────────────────────────────────────────
# Install:
#   systemctl --user daemon-reload
#   systemctl --user enable --now nexus-gateway.service
#
# Verify:
#   systemctl --user status nexus-gateway.service
#   journalctl --user -u nexus-gateway.service -f
# ─────────────────────────────────────────────────────────────

[Unit]
Description=NexusRoute Gateway — Autonomous LLM Edge Interceptor, Cache & Telemetry Daemon
Documentation=https://github.com/shobix/nexusroute
After=network.target network-online.target omp.service
Wants=network-online.target

[Service]
Type=simple

# ── Environment ──
# Listen 4010 (tidak mengganggu OMP ecosystem di 4000-4001):
#   opencode -> nexus-gateway:4010 -> omp auth-gateway:4000
Environment=NEXUS_GATEWAY_PORT=4010
Environment=NEXUS_GATEWAY_TARGET_PORT=4000
Environment=NEXUS_GATEWAY_TARGET_HOST=127.0.0.1
Environment=NODE_ENV=production

# ── Runtime ──
# Path absolut bun: systemd user service tidak mewarisi PATH shell (~/.npm-global/bin)
ExecStart=%h/.npm-global/bin/bun run %h/civil/projects/nexusroute/src/index.ts start
WorkingDirectory=%h/civil/projects/nexusroute

# ── Resilience & Resource Limits ──
Restart=always
RestartSec=3
LimitNOFILE=65536

# ── Logging ──
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
